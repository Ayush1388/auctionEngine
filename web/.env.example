# Base URL of the auctionEngine API (cmd/api). The API must list this app's
# origin in CORS_ALLOWED_ORIGINS (http://localhost:5173 in the root .env.example).
VITE_API_URL=http://localhost:4000
# WebSocket endpoint for live auction updates.
VITE_WS_URL=ws://localhost:4000/v1/ws
# ISO currency code. API amounts are integers in this currency's smallest unit.
VITE_CURRENCY=INR
