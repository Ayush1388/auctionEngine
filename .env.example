# Local development settings for `make run`. Copy to .env (gitignored).
# Start the dependencies first with `make infra`.

PORT=4000
ENVIRONMENT=development
DATABASE_URL=postgres://auction:auction@localhost:5432/auction?sslmode=disable
APP_BASE_URL=http://localhost:4000

# Development-only secrets. Generate real ones with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=auction-engine
ACCESS_TOKEN_TTL=15m
INTERNAL_TOKEN=dev-only-internal-token

# Emails go to Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@auction.local

# Optional: delete a line to run without that component.
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
KAFKA_BROKERS=localhost:9092
ADMIN_ADDR=:9090

# Optional: call the bidding service over gRPC (run `go run ./cmd/biddingsvc`).
# BIDDING_GRPC_ADDR=localhost:50051

# Optional: send traces to a local Jaeger (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Allow a local frontend dev server to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
