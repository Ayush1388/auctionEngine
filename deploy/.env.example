# Copy to deploy/.env and fill in. deploy/.env is gitignored: secrets never
# go into git. Generate each secret with:  openssl rand -hex 32

# Public address. A domain name turns on automatic HTTPS (Let's Encrypt);
# point its DNS A record at this machine first. ":80" = plain HTTP (local).
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# Secrets (required).
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Image to run. Leave as-is to build from this checkout, or use the image
# CI publishes, e.g. ghcr.io/ayush1388/auctionengine:latest
IMAGE=auctionengine:local

# Email. The defaults deliver to Mailpit (inbox at http://127.0.0.1:8025).
# For real email, use any SMTP provider's host, port and credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@auction.local

# Browser origins allowed to call the API (comma-separated), e.g.
# https://app.example.com
CORS_ALLOWED_ORIGINS=

# Fraction of requests traced (1.0 = all). Lower it under real traffic.
TRACE_SAMPLE_RATIO=1.0

# Backups: how often, and how long to keep them.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7
